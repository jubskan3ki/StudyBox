<mjml>
  <mj-head>
    <mj-title>Notification d'Événement - StudiMove</mj-title>
    <mj-attributes>
      <mj-all font-family="Roboto, Arial, sans-serif" />
      <mj-class
        name="primary-text"
        color="#333333"
        font-size="16px"
        line-height="1.6"
      />
      <mj-class
        name="footer-text"
        color="#888888"
        font-size="14px"
        line-height="1.6"
      />
    </mj-attributes>
    <mj-style>
      .button { background-color: #49D4C6; color: #FFFFFF; text-decoration:
      none; padding: 12px 30px; border-radius: 8px; font-weight: bold; display:
      inline-block; text-align: center; box-shadow: 0 4px 8px rgba(0, 0, 0,
      0.1); transition: transform 0.2s, box-shadow 0.2s; } .button:hover {
      background-color: #0F52BA; box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
      transform: scale(1.05); } .highlight { color: #0F52BA; font-weight: bold;
      } .footer-link { color: #888888; text-decoration: none; }
      .footer-link:hover { color: #0F52BA; text-decoration: underline; }
      .body-section { border-radius: 10px; box-shadow: 0 4px 5px rgba(0, 0, 0,
      0.1); }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F4F6" width="600px">
    <!-- En-tête avec logo -->
    <mj-wrapper full-width="full-width" padding="20px 0">
      <mj-section
        background-color="#FFFFFF"
        padding="20px"
        border-radius="12px"
        css-class="body-section"
      >
        <mj-column>
          <mj-image
            src="https://your-logo-url.com/logo.svg"
            width="120px"
            alt="StudiMove Logo"
            align="center"
          />
          <mj-text
            align="center"
            color="#0F52BA"
            font-size="22px"
            font-weight="bold"
            padding-top="10px"
          >
            {{.event_title}}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Section principale encadrée avec ombre et coins arrondis -->
    <mj-wrapper
      padding="20px"
      background-color="#FFFFFF"
      css-class="body-section"
      border-radius="12px"
    >
      <mj-section padding-left="20px" padding-right="20px">
        <mj-column>
          <!-- Message d'introduction -->
          <mj-text mj-class="primary-text">Bonjour,</mj-text>
          <mj-text mj-class="primary-text" padding-top="10px">
            Nous avons le plaisir de vous inviter à notre événement spécial :
            <span class="highlight">{{event_title}}</span>.
          </mj-text>

          <!-- Détails de l'événement -->
          <mj-text mj-class="primary-text" padding-top="20px">
            📅 Date : <strong>{{.event_date}}</strong><br />
            📍 Lieu : <strong>{{.event_location}}</strong>
          </mj-text>

          <!-- Bouton d'accès à l'événement -->
          <mj-text align="center" padding-top="30px">
            <a href="{{event_link}}" class="button">Voir les détails</a>
          </mj-text>

          <!-- Message de fin -->
          <mj-text mj-class="primary-text" padding-top="20px">
            Nous espérons vous voir à cet événement !
          </mj-text>

          <!-- Signature -->
          <mj-text mj-class="primary-text" font-weight="bold">
            Cordialement,
          </mj-text>
          <mj-text mj-class="primary-text">L'équipe StudiMove</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Footer avec réseaux sociaux -->
    <mj-wrapper full-width="full-width" padding="20px 0">
      <mj-section
        background-color="#FFFFFF"
        border-radius="12px"
        css-class="body-section"
      >
        <mj-column>
          <mj-text align="center" mj-class="footer-text" padding-top="10px">
            Vous recevez cet email car vous avez demandé des notifications
            d'événements.<br />
            StudiMove, Adresse de l'entreprise<br />
            Ville, Code Postal, Pays
          </mj-text>

          <!-- Liens sociaux -->
          <mj-social
            icon-size="24px"
            mode="horizontal"
            align="center"
            padding-top="20px"
          >
            <mj-social-element
              name="facebook"
              href="https://facebook.com/studimove"
              background-color="#0F52BA"
            ></mj-social-element>
            <mj-social-element
              name="twitter"
              href="https://twitter.com/studimove"
              background-color="#0F52BA"
            ></mj-social-element>
            <mj-social-element
              name="linkedin"
              href="https://linkedin.com/studimove"
              background-color="#0F52BA"
            ></mj-social-element>
          </mj-social>

          <!-- Liens de désabonnement et confidentialité -->
          <mj-text align="center" mj-class="footer-text" padding-top="20px">
            <a href="https://privacy.studimove.com" class="footer-link"
              >Politique de confidentialité</a
            >
            |
            <a href="https://unsubscribe.studimove.com" class="footer-link"
              >Se désabonner</a
            >
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
